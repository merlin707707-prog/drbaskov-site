---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Владислав Басков — врач-психотерапевт. КПТ и схематерапия, юнгианский анализ, гипнотерапия. Приём в Москве и онлайн.' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: 'Владислав Басков',
  alternateName: ['Басков Владислав Юрьевич', 'Басков Владислав', 'Владислав Юрьевич Басков'],
  medicalSpecialty: 'Psychiatric',
  description: 'Врач-психотерапевт: КПТ, схематерапия, юнгианский анализ, гипнотерапия, интегративный подход',
  address: { '@type': 'PostalAddress', streetAddress: 'ул. Маросейка, 9/2', addressLocality: 'Москва', addressCountry: 'RU' },
  telephone: '+79772514879',
  priceRange: '4000–7000 RUB',
  url: 'https://drbaskov.ru'
};
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="yandex-verification" content="676e1bec091e05c6" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>
    (function(){
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light') document.documentElement.setAttribute('data-theme','light');
      } catch(e){}
    })();
  </script>
</head>
<body>
  <nav>
    <div class="wrap">
      <a class="logo" href="/">Dr.<span>Басков</span></a>
      <ul>
        <li><a href="/#methods">Методы</a></li>
        <li><a href="/#process">Как проходит</a></li>
        <li><a href="/#about">Обо мне</a></li>
        <li><a href="/#pricing">Стоимость</a></li>
        <li><a href="/tests/">Тесты</a></li>
        <li><a href="/blog/">Статьи</a></li>
        <li><a href="/psihologam/">Психологам</a></li>
      </ul>
      <div class="nav-right">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Переключить тему"></button>
        <a class="btn nav-cta" href="/#contact">Записаться</a>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} Басков Владислав Юрьевич · врач-психиатр, психотерапевт</span>
      <span class="footer-b17"><a href="https://www.b17.ru/baskov/?prt=141482" target="_blank" rel="noopener"><img src="https://www.b17.ru/img/b17_100x100_b_retina.png" alt="Профиль Владислава Баскова на B17.ru" width="36" height="36" loading="lazy" /><span>Моя анкета на B17.ru</span></a></span>
      <span><a href="/pomosch/">Если очень тяжело</a> · Не является публичной офертой · <a href="/privacy/">Политика конфиденциальности</a></span>
    </div>
  </footer>

  <script is:inline>
    (function(){
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function(){
        var root = document.documentElement;
        var light = root.getAttribute('data-theme') === 'light';
        if (light) { root.removeAttribute('data-theme'); }
        else { root.setAttribute('data-theme','light'); }
        try { localStorage.setItem('theme', light ? 'dark' : 'light'); } catch(e){}
      });
    })();
  </script>

  <!-- Yandex.Metrika counter -->
  <script is:inline type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    ym(110630668, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/110630668" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  <!-- /Yandex.Metrika counter -->
</body>
</html>
